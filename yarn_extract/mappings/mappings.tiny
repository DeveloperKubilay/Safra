	f	I	field_30465	SMALL_MONSTER_XP
		c	@apiNote This is used for monsters such as\n{@linkplain EndermiteEntity endermites} and\n{@linkplain VexEntity vexes}.
	f	I	field_30468	STRONGER_MONSTER_XP
