+        long now = 0;
+        for (int i = 0; i < 10_000; i++) {
+            now += (1L + random.nextInt(2_000)) * 1_000_000;
+            long window = tuner.consumed(1 + random.nextInt(262_144), random.nextInt(262_144), now,
